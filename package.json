{
  "name": "tcf-canada-oral-studio",
  "version": "1.0.0",
  "private": true,
  "description": "TCF Canada Expression Orale Simulator \u2014 Local Desktop Examiner with Live Voice Dialogue, Recording & AI Grammar/CEFR Grading",
  "bin": "dist/bundle.cjs",
  "scripts": {
    "dev": "tsx src/main.ts",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs --minify",
    "build:all": "npm run bundle && npx @yao-pkg/pkg ."
  },
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-arm64",
      "node20-macos-x64",
      "node20-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@yao-pkg/pkg": "^5.11.5",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}